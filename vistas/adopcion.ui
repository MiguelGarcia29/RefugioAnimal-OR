}

/* Estilo para todos los botones dentro del panel */
QPushButton {
    background-color: transparent;
    color: white;
    text-align: left;
    padding: 10px;
    font-size: 16px;
    border: none;
}

/* Efecto cuando pasas el ratón por encima */
QPushButton:hover {
    background-color: #3eb038;
}</string>
