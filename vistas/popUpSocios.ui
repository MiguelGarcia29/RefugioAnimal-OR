    <widget class="QFrame" name="frame_2">
     <property name="styleSheet">
      <string notr="true">.QFrame{
	background-color:white;
}

.QLabel{
	color: #1b5e20;
}

/* --- Estilo Base para TODOS los inputs (Linea 2, Linea 3, Linea 4, Linea 5, Linea 6) --- */
QLineEdit, QComboBox, QDateEdit, QPlainTextEdit {
    border: 2px solid #1b5e20; /* El borde verde oscuro */
    border-radius: 10px;        /* Bordes bien redondeados */
    padding: 10px 15px;         /* Aire dentro de la caja */
    color: #333333;             /* Color del texto que escribe el usuario */
    font-size: 14px;
}

/* Efecto al pasar el ratón (Hover) y al hacer clic (Focus) */
QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QPlainTextEdit:focus {
    background-color: #f9f9f9; /* Un gris casi imperceptible */
    border-color: #4caf50;      /* Verde más brillante */
}

/* --- Estilo para el texto de ayuda (Placeholder gris) --- */
/* (Para QLineEdit, QDateEdit y QPlainTextEdit) */
QLineEdit::placeholder, QPlainTextEdit::placeholder {
    color: #888888; /* Gris suave */
    font-style: italic; /* Un toque de estilo */
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

/* Estilo de la flechita (puedes usar una imagen o un caracter) */
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

/* --- Título &quot;Sexo del animal:&quot; --- */
QLabel#lbl_sexo_titulo {
    color: #1b5e20;
    font-weight: bold;
    font-size: 14px;
    margin-bottom: 5px;
}

/* --- Estilo para los Checkboxes (Macho / Hembra) --- */
QCheckBox {
    color: #333333;
    font-size: 14px;
    spacing: 10px; /* Espacio entre el cuadro y el texto */
}

/* Estilo del cuadradito del Checkbox */
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #1b5e20;
    border-radius: 5px;
    background-color: white;
}

/* Cuando está marcado (Checked) */
QCheckBox::indicator:checked {
    background-color: #1b5e20; /* Fondo verde completo */
}

/* Estilo del botón desplegable (la zona de clic) */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 550px; /* Lo hacemos ancho para que sea fácil de clicar */
    border-left: 1px solid #dcdcdc; /* Una rayita separadora */
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
	border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

/* Cambiar la flecha por un &quot;icono&quot; visual */
QDateEdit::down-arrow {
    image: url(Interfaz/img/calendario.png); /* Icono */
    width: 30px;
    height: 30px;
}

/* Estilo general del CheckBox (el texto y el espacio) */
QCheckBox {
    color: #333333;
    font-size: 14px;
    font-weight: 500;
    spacing: 8px; /* Espacio entre el cuadro y el texto &quot;Macho/Hembra&quot; */
    padding: 5px;
}

/* 1. El cuadro (indicador) en estado normal */
QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #1b5e20; /* Borde verde oscuro igual que los inputs */
    border-radius: 6px;        /* Bordes suavemente redondeados */
    background-color: white;
}

/* 2. Cuando pasas el ratón por encima (Hover) */
QCheckBox::indicator:hover {
    border-color: #4caf50;      /* Verde más claro */
    background-color: #f1f8e9; /* Un toque de fondo verdoso muy suave */
}

/* 3. Cuando está MARCADO (Checked) */
QCheckBox::indicator:checked {
    background-color: #1b5e20; /* Fondo verde sólido */
    border-color: #1b5e20;
    /* Aquí definimos el &quot;check&quot; blanco. 
       Si no tienes una imagen, podemos usar un estilo de borde para simularlo, 
       pero lo mejor es usar un icono PNG blanco */
    image: url(assets/check_blanco.png); 
}

/* 4. Cuando está marcado y pasas el ratón */
QCheckBox::indicator:checked:hover {
    background-color: #2e7d32;
    border-color: #2e7d32;
}

/* 5. Estado deshabilitado (por si acaso) */
QCheckBox:disabled {
    color: #aaaaaa;
}

QCheckBox::indicator:disabled {
    border-color: #cccccc;
    background-color: #eeeeee;
}</string>
