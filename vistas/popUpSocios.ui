   <item>
    <widget class="QFrame" name="frame">
     <property name="styleSheet">
      <string notr="true">.QFrame{
	background-color: white;
}

/* Estilo general del botón en estado normal */
QPushButton {
    background-color: #2e7d32; /* Un verde más suave y oscuro, tipo &quot;Forest Green&quot; */
    color: white; /* Texto blanco */
    border: 1px solid #1b5e20; /* Un borde sutil aún más oscuro */
    border-radius: 8px; /* Bordes redondeados modernos */
    font-size: 14px;
    font-weight: bold; /* Texto en negrita */
    padding-top: 8px; /* &quot;Aire&quot; arriba y abajo */
    padding-bottom: 8px;
    padding-left: 20px; /* &quot;Aire&quot; a los lados */
    padding-right: 20px;
    min-width: 100px; /* Ancho mínimo para que no se encoja mucho */
}

/* Efecto al pasar el ratón (Hover) */
QPushButton:hover {
    background-color: #388e3c; /* Un verde un poco más claro al hacer hover */
    border: 1px solid #2e7d32;
}

/* Efecto al hacer clic (Pressed) */
QPushButton:pressed {
    background-color: #1b5e20; /* Más oscuro aún cuando está pulsado */
    padding-top: 10px; /* Efecto sutil de presión */
    padding-bottom: 6px;
}</string>
