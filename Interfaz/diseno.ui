       <string notr="true">/* Color de fondo del panel lateral */
#frame_lateral {
    background-color: #2d8a27; /* El verde de tu captura */
    border: none;
}

/* Estilo para todos los botones dentro del panel */
QPushButton {
    background-color: transparent;
    color: white;
    text-align: left;
    padding: 10px;
    font-size: 16px;
    border: none;
}

/* Efecto cuando pasas el ratón por encima */
QPushButton:hover {
    background-color: #3eb038;
}</string>
